    <!-- ==================== NOTA ==================== -->
    <mxCell id="nota" value="Entidades del modelo ER involucradas: PERSONA (1:N) OPERADOR (N:M) ACTIVIDAD_ECONOMICA, OPERADOR (1:N) REQUISITO / ADJUNTO, OPERADOR (1:N) CERTIFICADO (N:M) ACTIVIDAD_ECONOMICA, CATEGORIA (1:N) REQUISITO. La persona solo ve sus propios legajos/sucursales y su jerarquía; el supervisor/admin ve todos los operadores, el padrón completo y toda la jerarquía." style="shape=note;whiteSpace=wrap;html=1;fontSize=10;align=left;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="220" y="1170" width="980" height="60" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
