        <mxCell id="rel_operador_oa" value="N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d6b656;" edge="1" parent="1" source="operadores" target="operador_actividades">
