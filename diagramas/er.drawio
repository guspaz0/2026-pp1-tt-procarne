        <!-- ================= NOTA ================= -->
        <mxCell id="nota" value="Dos relaciones N:M con el catálogo de actividades:\n1) operadores ↔ actividades_economicas vía operador_actividades (ORM + wiring en alta: pendiente).\n2) certificados ↔ actividades_economicas vía certificado_actividades (implementada, migración 89577a6c3b6f). La columna texto certificados.actividades_economicas queda como resumen denormalizado para el PDF." style="shape=note;whiteSpace=wrap;html=1;background=#fffbe6;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;fontStyle=0;spacing=8;" vertex="1" parent="1">
