        <!-- operadores 1 : N certificados -->
        <mxCell id="rel_operador_certificados" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#4a90d9;" edge="1" parent="1" source="operadores" target="certificados">
