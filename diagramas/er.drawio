        <mxCell id="rel_ca_actividad" value="N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" parent="1" source="certificado_actividades" target="actividades">
          <mxGeometry relative="1" as="geometry" />
