#!/bin/sh
# Launcher: el bundle headless-shell del sandbox está incompleto (sin ICU) y
# las carpetas ~/Library de Chromium están bloqueadas por TCC en este entorno.
# Delegate al Edge instalado con el perfil, crashes y TMPDIR en /tmp (writable).
export TMPDIR=/tmp/rocca-pw-tmp
mkdir -p "$TMPDIR" /tmp/rocca-pw-edge
ARGS=""
for a in "$@"; do
  case "$a" in
    --user-data-dir=*|--user-data-dir) continue ;;
  esac
  ARGS="$ARGS $a"
done
exec "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge" \
  --user-data-dir=/tmp/rocca-pw-edge \
  --crash-dumps-dir=/tmp/rocca-pw-edge/crashes \
  $ARGS
